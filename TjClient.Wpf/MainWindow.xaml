<Window x:Class="TjClient.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TJ Cloud Client - доставка ТЖ" Width="960" Height="760" MinWidth="820" MinHeight="760" Background="#F6F8FB" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="32"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="32"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="#EDF1F7"/><Setter Property="Foreground" Value="#38577C"/></Style>
    <Style x:Key="QueueText" TargetType="TextBlock"><Setter Property="Margin" Value="8,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="FileText" TargetType="TextBlock" BasedOn="{StaticResource QueueText}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Path}"/></Style>
    <Style x:Key="ProgressText" TargetType="TextBlock" BasedOn="{StaticResource QueueText}"><Setter Property="ToolTip" Value="{Binding Details}"/></Style>
  </Window.Resources>
  <Grid x:Name="RootPanel" Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Доставка технологического журнала" FontSize="22" FontWeight="SemiBold" Foreground="#162B49" Margin="0,0,0,16"/>
    <StackPanel x:Name="SettingsPanel" Grid.Row="1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Папка выгрузок" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <DockPanel Grid.Column="1" Margin="0,0,0,8"><Button Content="Выбрать..." DockPanel.Dock="Right" Click="ChooseFolder" Margin="8,0,0,0"/><TextBox x:Name="FolderBox" ToolTip="Локальный или UNC-путь с правами текущего пользователя. Только завершённые выгрузки."/></DockPanel>
        <TextBlock Grid.Row="1" Text="Ключ источника" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="TokenBox" Height="32" Padding="7,4" VerticalContentAlignment="Center" ToolTip="Хранится с DPAPI CurrentUser. При смене адреса ключ очищается."/>
      </Grid>
      <Expander x:Name="SettingsExpander" IsExpanded="False" Margin="0,12,0,0">
        <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Настройки" FontWeight="SemiBold"/><TextBlock x:Name="ModeCaption" Foreground="#56657B" Margin="14,0,0,0"/></StackPanel></Expander.Header>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Адрес сервиса" VerticalAlignment="Center" Margin="0,0,0,8"/><TextBox Grid.Column="1" x:Name="EndpointBox" Margin="0,0,0,8" ToolTip="https://имя-сервера без подпути, параметров и логина"/>
          <TextBlock Grid.Row="1" Text="Интервал, секунд" VerticalAlignment="Center" Margin="0,0,0,8"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8"><TextBox x:Name="IntervalBox" Width="90" Text="60"/><TextBlock Text="от 5 до 86400" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#56657B"/></StackPanel>
          <TextBlock Grid.Row="2" Text="Начальный режим" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="2" Grid.Column="1" x:Name="ModePanel" Margin="0,0,0,4">
            <RadioButton x:Name="NewFilesRadio" GroupName="InitialMode" Content="Только новые файлы после начала наблюдения" IsChecked="True" Height="32" VerticalContentAlignment="Center"/>
            <StackPanel Orientation="Horizontal"><RadioButton x:Name="SinceRadio" GroupName="InitialMode" Content="Существующие с датой изменения от" Height="32" VerticalContentAlignment="Center"/><DatePicker x:Name="SincePicker" Width="150" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="12,0,0,0"/></StackPanel>
          </StackPanel>
          <CheckBox Grid.Row="3" Grid.Column="1" x:Name="StartupBox" Content="Запускать при входе в Windows" ToolTip="Только для текущего пользователя. Автозапуск меняется только по нажатию этого флажка."/>
        </Grid>
      </Expander>
    </StackPanel>
    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Получатель"/><TextBlock Grid.Column="1" x:Name="RecipientText" TextWrapping="Wrap" Foreground="#38577C"/></Grid>
    <StackPanel Grid.Row="3" Margin="0,8,0,12">
      <CheckBox x:Name="FinishedCheck" Content="Подтверждаю: только завершённые выгрузки, не активная папка ТЖ" ToolTip="Выбранная папка содержит завершённые выгрузки. Поставщик публикует .log атомарным переименованием после окончания записи. Активная папка ТЖ не подходит. Клиент не меняет и не удаляет исходники."/>
      <CheckBox x:Name="RecipientCheck" Content="Разрешаю передавать файлы из этой папки указанному получателю" IsEnabled="False" ToolTip="Передаются только завершённые выгрузки из выбранной папки проверенному получателю. Проверьте адрес выше. При смене папки или адреса согласие требуется заново."/>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,14">
      <Button x:Name="CheckButton" Content="Проверить" Click="CheckClick"/>
      <Button x:Name="StartButton" Content="Запустить" Click="StartClick" Background="#2459B5" Foreground="White"/>
      <Button x:Name="PauseButton" Content="Пауза" Click="PauseClick" Visibility="Collapsed" Background="#2459B5" Foreground="White"/>
      <Button x:Name="MoreButton" Content="Ещё ▾" Click="MoreClick"><Button.ContextMenu><ContextMenu><MenuItem x:Name="SendButton" Header="Отправить сейчас" Click="SendClick"/><MenuItem x:Name="OpenButton" Header="Открыть сайт" Click="OpenClick"/><MenuItem x:Name="RetryButton" Header="Повторить выбранное" Click="RetryClick"/></ContextMenu></Button.ContextMenu></Button>
    </StackPanel>
    <StackPanel Grid.Row="5" Margin="0,0,0,10"><TextBlock x:Name="StatusText" Text="На паузе. Укажите параметры и нажмите «Проверить»." TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock x:Name="LastContactText" Text="Последняя успешная связь: нет" Foreground="#56657B" Margin="0,4,0,0"/></StackPanel>
    <DataGrid Grid.Row="6" x:Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F7" HeadersVisibility="Column" Background="White" BorderBrush="#C6D1E0" RowHeight="30" EnableRowVirtualization="True">
      <DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding Path}" Width="*" MinWidth="150" ElementStyle="{StaticResource FileText}"/><DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="210" ElementStyle="{StaticResource QueueText}"/><DataGridTextColumn Header="Передано" Binding="{Binding Progress}" Width="175" ElementStyle="{StaticResource ProgressText}"/></DataGrid.Columns>
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle>
    </DataGrid>
    <Grid Grid.Row="7" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="TotalText" Text="всего 0"/><TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="Закрытие - в трей. Выход - через меню значка." Foreground="#56657B" FontSize="12"/></Grid>
  </Grid>
</Window>
