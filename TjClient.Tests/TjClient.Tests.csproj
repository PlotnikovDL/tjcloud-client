<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../TjClient.Core/TjClient.Core.csproj" /><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup>
    <Page Include="../TjClient.Wpf/MainWindow.xaml" Link="MainWindow.xaml" />
    <Compile Include="../TjClient.Wpf/MainWindow.xaml.cs" Link="MainWindow.xaml.cs" />
    <EmbeddedResource Include="../TjClient.Wpf/Assets/tjcloud-client.ico" LogicalName="TjCloudClient.Branding.Icon" />
  </ItemGroup>
</Project>
